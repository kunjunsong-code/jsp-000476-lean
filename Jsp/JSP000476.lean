import Init.Data.List.Basic

set_option maxRecDepth 100000

def isSquare (n : Nat) : Bool :=
  (List.range (n + 1)).any (fun k => k * k == n)

def powerSet {alpha : Type} : List alpha -> List (List alpha)
| [] => [[]]
| (x :: xs) => (powerSet xs).map (fun s => x :: s) ++ powerSet xs

def nonemptySubsetSums (S : List Nat) : List Nat :=
  (powerSet S).filter (fun s => ! s.isEmpty) |>.map List.sum

def noSquareSubsetSum (S : List Nat) : Bool :=
  (nonemptySubsetSums S).all (fun s => (not (isSquare s)))

def hasSquareSubsetSum (S : List Nat) : Bool :=
  ! noSquareSubsetSum S

def witness4 : List Nat := [2, 3, 5, 10]

theorem witness4_is_good : noSquareSubsetSum witness4 = true := by decide

theorem witness4_in_range : (witness4.all (fun x => 2 <= x && x <= 10)) = true := by decide
